{
  "id": "ambient_rgb",
  "title": "Ambient RGB",
  "description": "BMW Ambient RGB Controller: a full colour wheel for the factory ambient lighting, with fades, a rainbow mode and zones. Any colour, live, through the body controller's own light actuator (verified on a G20); OEM control restored at a press or by itself.",
  "version": "0.2.0",
  "vendor": "custom",
  "loggingId": "OAB1",
  "iconGlyph": "RGB",
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.controlelements.FrontCCU": {
      "_optional": "the iDrive knob cannot turn the hue (buttons still work)",
      "statusRotaryEncoderState": "s"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "_optional": "no parked check",
      "statusCarSpeed2": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Ambient RGB",
      "buttons": [
        [
          "BTN_CUSTOM",
          "Custom on/off"
        ],
        [
          "BTN_OEM",
          "Restore OEM"
        ],
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "backend",
      "label": "Lighting link",
      "type": "choice",
      "default": "mock",
      "options": [
        [
          "mock",
          "Simulated BDC (safe)"
        ],
        [
          "bdc",
          "Car: BDC over diagnostic link"
        ],
        [
          "someip",
          "Car: SOME/IP probe only"
        ]
      ]
    },
    {
      "key": "arm",
      "label": "Write to the car",
      "type": "choice",
      "default": "off",
      "options": [
        [
          "off",
          "Disarmed: dry runs only (safe)"
        ],
        [
          "on",
          "Armed: drives the real lights"
        ]
      ]
    },
    {
      "key": "refresh",
      "label": "Keep-alive (seconds per write)",
      "type": "number",
