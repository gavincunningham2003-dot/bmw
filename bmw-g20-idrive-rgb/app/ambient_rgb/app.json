{
  "id": "ambient_rgb",
  "title": "Ambient RGB",
  "description": "BMW Ambient RGB Controller: colour wheel and circular brightness dial, dual colour (upper / lower), zones, Rainbow, Smooth Fade, Breathing, Colour Wave, Welcome Sweep and Sport Pulse, lighting by driving mode, saved configurations. Preview on screen, apply on confirmation; the body controller's own light actuator (verified on a G20); the factory lighting keeps priority and is restored at a press or by itself.",
  "version": "0.4.0",
  "vendor": "custom",
  "loggingId": "OAB1",
  "iconGlyph": "RGB",
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.controlelements.FrontCCU": {
      "_optional": "the iDrive knob cannot turn the hue (buttons still work)",
      "statusRotaryEncoderState": "s"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "_optional": "no parked check",
      "statusCarSpeed2": "rs"
    },
    "de.bmw.body.interiorillumination.AmbientLight": {
      "_optional": "no factory lighting read-out on Diagnostics",
      "ambientLightActive": "rs",
      "brightnessAmbientLight": "rs",
      "brightnessAmbientContourLine": "rs",
      "currentInteriorLightProfile": "rs"
    },
    "de.bmw.infotainment.misc.ComfortFunctionIuK": {
      "_optional": "no factory colour read-out on Diagnostics",
      "statusAmbientLightInteriorColour": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "no lighting by driving mode",
      "statusFESVehicleDynamicSwitchHMI": "rs"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "the car locked and left is not noticed (the lighting still lapses by itself)",
      "VehicleCondition": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Ambient RGB",
      "buttons": [
        [
          "BTN_APPLY",
          "Apply"
        ],
        [
          "BTN_OEM",
          "Restore OEM"
        ],
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "backend",
      "label": "Lighting link",
      "type": "choice",
      "default": "mock",
      "options": [
        [
          "mock",
          "Simulated BDC (safe)"
        ],
        [
          "bdc",
          "Car: BDC over diagnostic link"
        ],
        [
          "someip",
          "Car: SOME/IP probe only"
        ]
      ]
    },
    {
      "key": "arm",
      "label": "Write to the car",
      "type": "choice",
      "default": "off",
      "options": [
        [
          "off",
          "Disarmed: dry runs only (safe)"
        ],
        [
          "on",
          "Armed: drives the real lights"
        ]
      ]
    },
    {
      "key": "refresh",
      "label": "Keep-alive (seconds per write)",
      "type": "number",
      "unit": "s",
      "default": 10,
      "steps": [
        4,
        6,
        10,
        15,
        20,
        30
      ]
    },
    {
      "key": "confirmApplies",
      "label": "Press to confirm applies",
      "type": "choice",
      "default": "on",
      "options": [
        [
          "on",
          "Yes: confirming a wheel or dial applies it"
        ],
        [
          "off",
          "No: only the Apply button applies"
        ]
      ]
    },
    {
      "key": "autoApply",
      "label": "Apply the last lighting at start",
