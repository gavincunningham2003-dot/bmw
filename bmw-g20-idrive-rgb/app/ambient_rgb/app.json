{
  "id": "ambient_rgb",
  "title": "Ambient RGB",
  "description": "BMW Ambient RGB Controller: colour wheel and circular brightness dial, dual colour (upper / lower), zones, Rainbow, Smooth Fade, Breathing and Colour Wave modes, saved configurations. Preview on screen, apply on confirmation; the body controller's own light actuator (verified on a G20); OEM restored at a press or by itself.",
  "version": "0.3.0",
  "vendor": "custom",
  "loggingId": "OAB1",
  "iconGlyph": "RGB",
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.controlelements.FrontCCU": {
      "_optional": "the iDrive knob cannot turn the hue (buttons still work)",
      "statusRotaryEncoderState": "s"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "_optional": "no parked check",
      "statusCarSpeed2": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Ambient RGB",
      "buttons": [
        [
          "BTN_APPLY",
          "Apply"
        ],
        [
          "BTN_OEM",
          "Restore OEM"
        ],
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "backend",
      "label": "Lighting link",
      "type": "choice",
      "default": "mock",
      "options": [
        [
          "mock",
          "Simulated BDC (safe)"
        ],
        [
          "bdc",
          "Car: BDC over diagnostic link"
        ],
        [
          "someip",
          "Car: SOME/IP probe only"
        ]
      ]
    },
    {
      "key": "arm",
      "label": "Write to the car",
      "type": "choice",
      "default": "off",
      "options": [
        [
          "off",
          "Disarmed: dry runs only (safe)"
        ],
        [
          "on",
          "Armed: drives the real lights"
        ]
      ]
    },
    {
      "key": "refresh",
      "label": "Keep-alive (seconds per write)",
      "type": "number",
      "unit": "s",
      "default": 10,
      "steps": [
        4,
        6,
        10,
        15,
        20,
        30
      ]
    },
    {
      "key": "confirmApplies",
      "label": "Press to confirm applies",
      "type": "choice",
      "default": "on",
      "options": [
        [
          "on",
          "Yes: confirming a wheel or dial applies it"
        ],
        [
          "off",
          "No: only the Apply button applies"
        ]
      ]
    },
    {
      "key": "autoApply",
      "label": "Apply the last lighting at start",
      "type": "choice",
      "default": "off",
      "options": [
        [
          "off",
          "No: the car starts with its factory lighting"
        ],
        [
          "on",
          "Yes: the last applied lighting comes back when the app starts (parked, link ready)"
        ]
      ]
    },
    {
      "key": "handles",
      "label": "Door handle lights belong to",
      "type": "choice",
      "default": "bottom",
      "options": [
        [
          "bottom",
          "Lower lighting"
        ],
        [
          "top",
          "Upper lighting"
        ],
        [
          "off",
          "Neither (left OEM)"
        ]
      ]
    },
    {
      "key": "parked",
      "label": "Lighting changes while driving",
      "type": "choice",
      "default": "strict",
      "options": [
        [
          "strict",
          "Blocked unless parked (fail closed)"
        ],
        [
          "lenient",
          "Allowed (not recommended)"
        ]
      ]
    },
    {
      "key": "frame",
      "label": "Animation frame time",
      "type": "number",
      "unit": "ms",
      "default": 80,
      "steps": [
        50,
        80,
        120,
        200,
        400
      ]
    },
    {
      "key": "inflight",
      "label": "Writes in flight (experimental)",
      "type": "choice",
      "default": "1",
      "options": [
        [
          "1",
          "1 (TASU takes one at a time)"
        ],
        [
          "2",
          "2 (one per LIN bus)"
        ]
      ]
    },
    {
      "key": "simLatency",
      "label": "Simulated link latency",
      "type": "number",
      "unit": "ms",
      "default": 0,
      "steps": [
        0,
        5,
        14,
        30,
        60,
        120
      ]
    },
    {
      "key": "unknownVariant",
      "label": "Allow unknown BDC variant",
      "type": "choice",
      "default": "off",
      "options": [
        [
          "off",
          "No (safe)"
        ],
        [
          "on",
          "Yes, I know what I am doing"
        ]
      ]
    },
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M Red"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "ice",
          "Ice White"
        ],
        [
          "amber",
          "Night Amber"
        ]
      ]
    },
    {
      "key": "layout",
      "label": "Screen layout",
      "type": "choice",
      "default": "full",
      "options": [
        [
          "full",
          "Full screen"
        ],
        [
          "standard",
          "Standard"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "GPU 60 fps (default)"
        ],
        [
          "software",
          "Software"
        ]
      ]
    },
    {
      "key": "demo",
      "label": "Demo data",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Auto"
        ],
        [
          "on",
          "Always"
        ],
        [
          "off",
          "Never"
        ]
      ]
    }
  ]
}
