{
  "id": "ambient_rgb",
  "title": "Ambient RGB",
  "description": "BMW Ambient RGB Controller: colour wheel and brightness dial, dual colour (upper / lower), zones, the MGU App Kit Ambient Config's animations (Rainbow, Smooth Fade, Breathing, Colour Wave, Welcome Sweep, Sport Pulse) written a whole LIN bus at a time, lighting by driving mode, saved configurations, the indicator's side glowing green, dimming at night. Runs in the background; the factory lighting keeps priority: an open door's line goes back to BMW's own warning light, and custom lighting is released when the car is left or the factory ambient lighting is switched off.",
  "version": "0.5.1",
  "vendor": "custom",
  "loggingId": "OAB1",
  "iconGlyph": "RGB",
  "autostart": true,
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.controlelements.FrontCCU": {
      "_optional": "the iDrive knob cannot turn the hue (buttons still work)",
      "statusRotaryEncoderState": "s"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "_optional": "no parked check",
      "statusCarSpeed2": "rs"
    },
    "de.bmw.body.interiorillumination.AmbientLight": {
      "_optional": "the factory ambient lighting switched off is not noticed from this interface",
      "ambientLightActive": "rs",
      "brightnessAmbientLight": "rs",
      "brightnessAmbientContourLine": "rs",
      "currentInteriorLightProfile": "rs"
    },
    "de.bmw.infotainment.misc.ComfortFunctionIuK": {
      "_optional": "the factory ambient lighting switched off is not noticed from this interface",
      "statusAmbientLightInteriorColour": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "no lighting by driving mode",
      "statusFESVehicleDynamicSwitchHMI": "rs"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "the car locked and left is not noticed: custom lighting then stops by itself after 15 minutes without use",
      "VehicleCondition": "s"
    },
    "de.bmw.body.DoorsWindowsRoofMirrors": {
      "_optional": "an open door's contour line is not handed back to BMW's own warning light",
      "CentralLockingSystemAndPanelStatus": "s"
    },
    "de.bmw.body.Light": {
      "_optional": "no green glow with the turn indicators",
      "StatusFunctionsIndicators": "s"
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "_optional": "no dimming at night",
      "statusDayNightChangeOver": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Ambient RGB",
      "buttons": [
        [
          "BTN_APPLY",
          "Apply"
        ],
        [
          "BTN_OEM",
          "Restore OEM"
        ],
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "backend",
      "label": "Lighting link",
      "type": "choice",
      "default": "mock",
      "options": [
        [
          "mock",
          "Simulated BDC (safe)"
        ],
        [
          "bdc",
          "Car: BDC over diagnostic link"
        ],
        [
          "someip",
          "Car: SOME/IP probe only"
        ]
      ]
    },
    {
      "key": "arm",
      "label": "Write to the car",
      "type": "choice",
      "default": "off",
      "options": [
        [
          "off",
          "Disarmed: dry runs only (safe)"
        ],
        [
          "on",
          "Armed: drives the real lights"
        ]
      ]
    },
    {
      "key": "refresh",
      "label": "Keep-alive (seconds per write)",
      "type": "number",
      "unit": "s",
      "default": 10,
      "steps": [
        4,
        6,
        10,
        15,
        20,
        30
      ]
    },
    {
      "key": "confirmApplies",
      "label": "Press to confirm applies",
      "type": "choice",
      "default": "on",
      "options": [
        [
          "on",
          "Yes: confirming a wheel or dial applies it"
        ],
        [
          "off",
          "No: only the Apply button applies"
        ]
      ]
    },
    {
      "key": "autoApply",
      "label": "Apply the last lighting at start",
      "type": "choice",
      "default": "off",
      "options": [
        [
          "off",
          "No: the car starts with its factory lighting"
        ],
        [
          "on",
